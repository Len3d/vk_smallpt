// oidn_pool.comp -- 2x2 max pooling with stride 2 (core/pool.h: pooling_max, kernel 2x2, stride 2).
// One thread per destination pixel and 4-channel blocked chunk.
//
// Channel-blocked layout: the channel stride is padded to a multiple of 4, so a thread loads and
// stores one aligned 16-byte (FP32) / 8-byte (FP16) chunk with a single instruction and
// consecutive threads (consecutive pixels) touch consecutive chunks. Padding channels are carried
// through like real ones; no stage reads them as data.

#version 450

#ifdef OIDN_HALF_TENSOR
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#ifdef OIDN_HALF_TENSOR
layout(std430, binding = 0) readonly buffer SrcBuf { float16_t src[]; };
layout(std430, binding = 1) writeonly buffer DstBuf { float16_t dst[]; };
#else
layout(std430, binding = 0) readonly buffer SrcBuf { vec4 src[]; };
layout(std430, binding = 1) writeonly buffer DstBuf { vec4 dst[]; };
#endif

layout(push_constant) uniform Pc {
  int channels;
  int dstWidth;
  int dstHeight;
} pc;

int pad4(int c) { return (c + 3) & -4; }

vec4 ld(int base) {
#ifdef OIDN_HALF_TENSOR
  return vec4(float(src[base + 0]), float(src[base + 1]), float(src[base + 2]),
              float(src[base + 3]));
#else
  return src[base >> 2];
#endif
}

void st(int base, vec4 v) {
#ifdef OIDN_HALF_TENSOR
  dst[base + 0] = float16_t(v.x);
  dst[base + 1] = float16_t(v.y);
  dst[base + 2] = float16_t(v.z);
  dst[base + 3] = float16_t(v.w);
#else
  dst[base >> 2] = v;
#endif
}

void main() {
  const int x = int(gl_GlobalInvocationID.x);
  const int y = int(gl_GlobalInvocationID.y);
  const int c0 = int(gl_GlobalInvocationID.z) * 4;
  const int stride = pad4(pc.channels);
  if (x >= pc.dstWidth || y >= pc.dstHeight || c0 >= stride) return;

  const int srcW = pc.dstWidth * 2;
  const int sx = x * 2;
  const int sy = y * 2;

  vec4 m = ld(((sy + 0) * srcW + sx + 0) * stride + c0);
  m = max(m, ld(((sy + 0) * srcW + sx + 1) * stride + c0));
  m = max(m, ld(((sy + 1) * srcW + sx + 0) * stride + c0));
  m = max(m, ld(((sy + 1) * srcW + sx + 1) * stride + c0));
  st((y * pc.dstWidth + x) * stride + c0, m);
}
